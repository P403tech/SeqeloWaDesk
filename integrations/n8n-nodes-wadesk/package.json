{
  "name": "n8n-nodes-wadesk",
  "version": "0.1.0",
  "description": "n8n community node for WaDesk — WhatsApp & omni-channel messaging. Trigger workflows from inbound messages, contacts, campaigns and more, and act back: send messages, create contacts, send templates, enroll in flows.",
  "keywords": [
    "n8n-community-node-package",
    "wadesk",
    "whatsapp",
    "messaging"
  ],
  "license": "MIT",
  "homepage": "",
  "author": {
    "name": ""
  },
  "engines": {
    "node": ">=18.10"
  },
  "main": "index.js",
  "scripts": {
    "build": "tsc && node copy-icons.js",
    "dev": "tsc --watch",
    "prepublishOnly": "npm run build"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/WaDeskApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/WaDesk/WaDesk.node.js",
      "dist/nodes/WaDesk/WaDeskTrigger.node.js"
    ]
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "n8n-workflow": "*",
    "typescript": "^5.4.0"
  }
}
